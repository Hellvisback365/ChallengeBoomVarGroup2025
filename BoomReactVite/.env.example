# ZENITH - VarGroup AI Workflow Suite
# Environment Variables Template

# =====================================================
# N8N WEBHOOK URLs
# =====================================================
# These URLs are used to connect to N8N workflow automation platform
# In production, these should be moved to environment variables and not hardcoded

# Chat AI Webhook (Zenith-Research)
VITE_VARGROUP_URL=https://your-n8n-instance.com/webhook/YOUR_CHAT_WEBHOOK_ID/chat

# Report Upload Webhook (Used in multiple phases)
VITE_REPORT_URL=https://your-n8n-instance.com/webhook/YOUR_REPORT_WEBHOOK_ID

# Transcription Webhook (Zenith-Transcript)
VITE_N8N_URL=https://your-n8n-instance.com/webhook/YOUR_TRANSCRIPTION_WEBHOOK_ID

# Final Report Webhook (Zenith-Report)
VITE_FINAL_REPORT_URL=https://your-n8n-instance.com/webhook/YOUR_FINAL_REPORT_WEBHOOK_ID

# =====================================================
# SECURITY CONFIGURATION (Future Implementation)
# =====================================================

# LocalStorage Encryption Key (for crypto-js AES encryption)
# VITE_STORAGE_ENCRYPTION_KEY=your-secret-encryption-key-here

# API Rate Limiting (requests per minute)
# VITE_API_RATE_LIMIT=60

# Session Timeout (milliseconds)
# VITE_SESSION_TIMEOUT=1800000

# =====================================================
# USAGE INSTRUCTIONS
# =====================================================
# 1. Copy this file to .env.production (for production builds)
# 2. Copy this file to .env.development (for local development)
# 3. Replace the URLs with your actual N8N webhook endpoints
# 4. NEVER commit .env.production or .env.development to git
# 5. In code, access variables using: import.meta.env.VITE_VARIABLE_NAME
#
# Example:
# const VARGROUP_URL = import.meta.env.VITE_VARGROUP_URL;
