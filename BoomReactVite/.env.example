# N8N Webhook URLs
# Replace these with your actual N8N webhook URLs

# VarGroup chat endpoint
VITE_VARGROUP_URL=https://your-domain.app.n8n.cloud/webhook/your-webhook-id/chat

# Report submission endpoint (shared by AssistenteVarGroup and FaseTrascrizione)
VITE_REPORT_URL=https://your-domain.app.n8n.cloud/webhook/your-webhook-id

# Transcription endpoint
VITE_TRANSCRIPT_URL=https://your-domain.app.n8n.cloud/webhook/trascrizione

# Final report generation endpoint
VITE_REPORT_FINAL_URL=https://your-domain.app.n8n.cloud/webhook/your-webhook-id
